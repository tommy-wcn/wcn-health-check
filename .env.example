# Supabase — copy this file to .env and fill in from
# supabase.com → your project → Project Settings → API
#
# Vite only exposes variables prefixed with VITE_ to the app.
# The anon key is safe for the browser; NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Airtable content sync (npm run sync:content) — server-side only, no VITE_ prefix
# Personal access token with data.records:read scope on the WCN base
AIRTABLE_TOKEN=pat...
